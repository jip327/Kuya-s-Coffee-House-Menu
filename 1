<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kuya Coffee House Menu</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white font-sans">
  <header class="text-center py-6">
    <h1 class="text-3xl font-bold">Kuya Coffee House</h1>
    <p class="italic text-gray-400">"Procrastinate and Palpitate"</p>
    <p class="mt-2">Open Daily: 10:00 AM - 6:00 PM | For Delivery: <strong>(0965) 329 - 0228</strong></p>
  </header>

  <main class="max-w-5xl mx-auto px-4">
    <section class="my-8">
      <h2 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-4">☕ Caffeinated</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div><strong>Aerocano / Americano</strong><br>75.00 / 85.00</div>
        <div><strong>Cafe Latte</strong><br>90.00 / 100.00</div>
        <div><strong>Salted Caramel Latte</strong><br>110.00 / 120.00</div>
        <div><strong>Vanilla Latte</strong><br>110.00 / 120.00</div>
        <div><strong>Cinnamon Spiced Latte</strong><br>110.00 / 115.00</div>
        <div><strong>Nutella Mocha</strong><br>110.00 / 120.00</div>
        <div><strong>Coffee Jelly</strong><br>120.00 / 130.00</div>
      </div>
    </section>

    <section class="my-8">
      <h2 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-4">🌟 Cafe Specials</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div><strong>Spanish Latte</strong><br>110.00 / 120.00</div>
        <div><strong>White Peppermint Mocha</strong><br>115.00 / 125.00</div>
        <div><strong>Caramel Pop Latte</strong><br>115.00 / 125.00</div>
      </div>
    </section>

    <section class="my-8">
      <h2 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-4">✨ Signature Drink</h2>
      <div><strong>Kape De Cueba</strong><br>115.00 / 125.00</div>
    </section>

    <section class="my-8">
      <h2 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-4">🌱 Non-Caffeinated</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div><strong>Matcha Latte</strong><br>85.00 / 95.00</div>
        <div><strong>Strawberry Milk</strong><br>85.00 / 95.00</div>
        <div><strong>Ube Latte</strong><br>85.00 / 95.00</div>
        <div><strong>Nutella Mudslide</strong><br>85.00 / 95.00</div>
        <div><strong>Harlequin</strong><br>100.00 / 110.00</div>
        <div><strong>Strawberry - Matcha Cloud</strong><br>120.00</div>
      </div>
    </section>

    <section class="my-8">
      <h2 class="text-xl font-semibold border-b border-gray-700 pb-2 mb-4">💧 Seltzers (16 oz)</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div><strong>Purple Rush</strong><br>95.00</div>
        <div><strong>Blue Cucumber</strong><br>120.00</div>
        <div><strong>Peppermint Kiwi</strong><br>120.00</div>
        <div><strong>Fizzy Berry</strong><br>120.00</div>
        <div><strong>Passion Fruit</strong><br>120.00</div>
        <div><strong>Cucumber Kiwi</strong><br>130.00</div>
      </div>
    </section>
  </main>

  <footer class="text-center text-gray-500 text-sm mt-10 mb-6">
    © 2025 Kuya Coffee House. All rights reserved.
  </footer>
</body>
</html>
